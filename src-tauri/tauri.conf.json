{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASTRO APP",
  "version": "1.0.0",
  "identifier": "com.astro.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ASTRO APP",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 660,
        "theme": "Dark",
        "backgroundColor": "#0b0b0c",
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
